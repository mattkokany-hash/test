# Copy to .env and fill in what you have. Everything is optional —
# the tool runs fully offline and in demo checkout mode with none of it set.

# Use Claude to design template content + marketplace listing copy.
ANTHROPIC_API_KEY=

# Model id for generation (default: claude-sonnet-5).
FORGE_MODEL=claude-sonnet-5

# Enable real payments. Without it, the storefront runs in demo mode
# (simulated purchase, free download) so you can try the full flow.
STRIPE_SECRET_KEY=

# Storefront port (default: 4000).
PORT=4000
